# Backend Environment Variables
# Copy to .env.local for development or .env.production for production

# MongoDB Connection
# Development: Local MongoDB
# Production: MongoDB Atlas cloud (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/tour-automation

# Server Port
PORT=5000

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# WooCommerce Configuration (same for all environments)
WOOCOMMERCE_SITE_URL=https://trypdeals.com
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret
